#!/usr/bin/lua
local options = {
    { "Lock", "hyprlock" },
    { "Shut down", "systemctl poweroff" },
    { "Reboot", "systemctl reboot" },
    { "Log out", "hyprctl dispatch exit 1" },
    { "Suspend", "systemctl suspend" },
    { "Hibernate", "systemctl hibernate" },
}

local labels = {}
for _, option in ipairs(options) do
    labels[#labels + 1] = option[1]
end

local menu = assert(io.popen(
    "printf '%s\\n' '" .. table.concat(labels, "' '")
        .. "' | fuzzel --placeholder 'Power Menu' --dmenu " .. #options,
    "r"
))
local selected = menu:read("*l")
menu:close()

for _, option in ipairs(options) do
    if selected == option[1] then
        os.execute(option[2])
        break
    end
end

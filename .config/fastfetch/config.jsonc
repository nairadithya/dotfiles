{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.txt",
    "color": {
        "1": "38;2;255;101;7"
    }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "os",
            "key": "os ",
            "keyColor": "38;2;255;101;7",  // = color4
        },
        {
            "type": "kernel",
            "key": "kernel ",
            "keyColor": "38;2;255;101;7",
        },
        {
            "type": "shell",
            "key": "shell ",
            "keyColor": "38;2;255;101;7", 
        },
        {
            "type": "terminal",
            "key": "terminal ",
            "keyColor": "38;2;255;101;7", 
        },
        {
            "type": "wm",
            "key": "wm ",
            "keyColor": "38;2;255;101;7", 
        },
        {
            "type": "terminalfont",
            "key": "terminalfont ",
            "keyColor": "38;2;255;101;7", 
        },
        {
            "type": "uptime",
            "key": "uptime ",
            "keyColor": "38;2;255;101;7", 
        },
        {
            "type": "datetime",
            "format": "{1}-{3}-{11}",
            "key": " ",
            "keyColor": "38;2;255;101;7", 
        },
        {
            "type": "media",
            "key": "media ",
            "keyColor": "38;2;255;101;7", 
        },
        {
            "type": "CPU",
            "key": "cpu ",
            "keyColor": "38;2;255;101;7", 
        },
        {
            "type": "GPU",
            "key": "gpu ",
            "keyColor": "38;2;255;101;7", 
        },
        {
            "type": "memory",
            "key": "memory ",
            "keyColor": "38;2;255;101;7"
        },
                {
            "type": "monitor",
            "key": "monitor ",
            "keyColor": "38;2;255;101;7",
        },

        ]
}

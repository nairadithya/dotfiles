{
	"layer": "bottom",
	"position": "top",
	"reload_style_on_change": true,
	"modules-left": [
		"clock",
	],
	"modules-center": [
		"hyprland/workspaces"
	],
	"modules-right": [
		"group/quicksettings"
	],
	"group/quicksettings": {
		"orientation": "horizontal",
		"modules": [
			"custom/dnd",
			"wireplumber",
			"bluetooth",
			"network",
			"battery"
		]
	},
	"hyprland/workspaces": {
		"persistent-workspaces": {
			"*": [
				1,
				2,
				3,
				4,
				5
			]
		}
	},
	"clock": {
		"format": "[ {:%a %d %B, %H:%M} ]",
		"interval": 1,
		"tooltip": true,
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"on-click-right": "mode",
			"format": {
				"today": "<span color='#ff6507'><b><u>{}</u></b></span>"
			}
		},
		"actions": {
			"on-click-right": "mode",
		}
	},

	"custom/dnd": {
		"exec": "~/.config/waybar/scripts/dnd",
		"return-type": "json",
		"interval": 2,
		"on-click": "~/.config/waybar/scripts/dnd toggle"
	},
	"wireplumber": {
		"format": "[ vol {volume}% ]",
		"format-muted": "[ vol muted ]",
		"scroll-step": 5.0,
		"on-click-right": "pavucontrol",
	},
	"bluetooth": {
		"format-on": "[ bt on ]",
		"format-off": "[ bt off ]",
		"format-connected": "[ bt {device_alias} ]",
		"format-disabled": "",
		"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
		"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
		"tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
        "on-click": "ghostty -e 'bluetuith'",
	},
	"network": {
		"format": "[ net {essid} ]",
		"format-ethernet": "[ net ethernet ]",
		"format-disconnected": "[ net offline ]",
		"tooltip-format-wifi": "{essid} ({signalStrength}%)",
		"tooltip-format-ethernet": "{ifname}",
		"on-click": "ghostty -e nmtui",
		"on-click-right": "nm-connection-editor",
		// "on-click": "uwsm app -- footclient --app-id=nmtui sh -c 'sleep 0.1; nmtui'"
	},
	"battery": {
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 20
		},
		"format": "[ bat {capacity}% ]",
		"format-charging": "[ bat {capacity}% charging ]",
		"format-plugged": "[ bat {capacity}% plugged ]",
		"interval": 15,
		"tooltip-format": "{capacity}%"
	}
}
